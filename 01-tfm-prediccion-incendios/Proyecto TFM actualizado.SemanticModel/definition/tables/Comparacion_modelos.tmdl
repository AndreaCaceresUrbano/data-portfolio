				  #"Encabezados promovidos" = Table.PromoteHeaders(#"Filas inferiores quitadas", [PromoteAllScalars = true]),
				  #"Tipo de columna cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos", {{"Accuracy_media", type number}, {"Accuracy_std", type number}, {"Precision_media", type number}, {"Recall_media", type number}, {"F1_media", type number}, {"ROC_AUC_media", type number}, {"ROC_AUC_std", type number}}, "es")
