	partition Comparacion_modelos = m
		mode: import
		source =
				let
				  Origen = Excel.Workbook(File.Contents("C:\Users\acace\Downloads\resultados_modelo_predictivo_TFM_CORREGIDO.xlsx"), null, false),
				  Comparacion_modelos_sheet = Origen{[Item = "Comparacion_modelos", Kind = "Sheet"]}[Data],
				  #"Filtrar contenido nulo y espacios en blanco" = each List.Select(_, each _ <> null and (not (_ is text) or Text.Trim(_) <> "")),
