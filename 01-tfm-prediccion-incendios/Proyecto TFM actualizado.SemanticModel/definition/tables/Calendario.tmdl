	partition Calendario = m
		mode: import
		source =
				let
				    // CONFIGURACIÓN DEL CALENDARIO
				    StartYear = 1980,
				    EndYear = Date.Year(DateTime.LocalNow()),
				    Today = Date.From(DateTime.LocalNow()),
				
				    StartDate = #date(StartYear, 1, 1),
				    EndDate = #date(EndYear, 12, 31),
				    NumberOfDays = Duration.Days(EndDate - StartDate) + 1,
				
				    DateList = List.Dates(
				        StartDate,
				        NumberOfDays,
				        #duration(1, 0, 0, 0)
				    ),
				
				    Source = Table.FromList(
				        DateList,
				        Splitter.SplitByNothing(),
				        {"Date"}
				    ),
				
				    ChangedType = Table.TransformColumnTypes(
				        Source,
				        {{"Date", type date}}
				    ),
				
				    // AÑO
				    AddYear = Table.AddColumn(
				        ChangedType, "Año",
				        each Date.Year([Date]), Int64.Type
				    ),
				
				    AddStartYear = Table.AddColumn(
				        AddYear, "Inicio Año",
				        each Date.StartOfYear([Date]), type date
				    ),
				
				    AddEndYear = Table.AddColumn(
				        AddStartYear, "Fin Año",
				        each Date.EndOfYear([Date]), type date
				    ),
				
				    // TRIMESTRE
				    AddQuarter = Table.AddColumn(
				        AddEndYear, "Trimestre Nº",
				        each Date.QuarterOfYear([Date]), Int64.Type
				    ),
				
				    AddQuarterName = Table.AddColumn(
				        AddQuarter, "Trimestre",
				        each "T" & Text.From([Trimestre Nº]), type text
				    ),
				
				    AddYearQuarter = Table.AddColumn(
				        AddQuarterName, "Año Trimestre",
				        each Text.From([Año]) & "-T" &
				             Text.From([Trimestre Nº]), type text
				    ),
				
				    AddStartQuarter = Table.AddColumn(
				        AddYearQuarter, "Inicio Trimestre",
				        each Date.StartOfQuarter([Date]), type date
				    ),
				
				    AddEndQuarter = Table.AddColumn(
				        AddStartQuarter, "Fin Trimestre",
				        each Date.EndOfQuarter([Date]), type date
				    ),
				
				    // MES
				    AddMonth = Table.AddColumn(
				        AddEndQuarter, "Mes",
				        each Date.Month([Date]), Int64.Type
				    ),
				
				    AddMonthName = Table.AddColumn(
				        AddMonth, "Nombre Mes",
				        each Date.MonthName([Date], "es-ES"), type text
				    ),
				
				    AddMonthShort = Table.AddColumn(
				        AddMonthName, "Mes Corto",
				        each Date.ToText([Date], "MMM", "es-ES"), type text
				    ),
				
				    AddMonthYear = Table.AddColumn(
				        AddMonthShort, "Mes Año",
				        each Date.ToText([Date], "MMM yyyy", "es-ES"),
				        type text
				    ),
				
				    AddYearMonth = Table.AddColumn(
				        AddMonthYear, "Año Mes",
				        each Date.ToText([Date], "yyyy-MM"), type text
				    ),
				
				    AddMonthYearOrder = Table.AddColumn(
				        AddYearMonth, "Mes Año (orden)",
				        each [Año] * 100 + [Mes], Int64.Type
				    ),
				
				    AddStartMonth = Table.AddColumn(
				        AddMonthYearOrder, "Inicio Mes",
				        each Date.StartOfMonth([Date]), type date
				    ),
				
				    AddEndMonth = Table.AddColumn(
				        AddStartMonth, "Fin Mes",
				        each Date.EndOfMonth([Date]), type date
				    ),
				
				    // SEMANA
				    AddWeek = Table.AddColumn(
				        AddEndMonth, "Semana",
				        each Date.WeekOfYear([Date], Day.Monday),
				        Int64.Type
				    ),
				
				    AddStartWeek = Table.AddColumn(
				        AddWeek, "Inicio Semana",
				        each Date.StartOfWeek([Date], Day.Monday),
				        type date
				    ),
				
				    AddEndWeek = Table.AddColumn(
				        AddStartWeek, "Fin Semana",
				        each Date.EndOfWeek([Date], Day.Monday),
				        type date
				    ),
				
				    // DÍA
				    AddDay = Table.AddColumn(
				        AddEndWeek, "Día",
				        each Date.Day([Date]), Int64.Type
				    ),
				
				    AddDayWeek = Table.AddColumn(
				        AddDay, "Día Semana Nº",
				        each Date.DayOfWeek([Date], Day.Monday) + 1,
				        Int64.Type
				    ),
				
				    AddDayName = Table.AddColumn(
				        AddDayWeek, "Nombre Día",
				        each Date.DayOfWeekName([Date], "es-ES"),
				        type text
				    ),
				
				    AddWeekend = Table.AddColumn(
				        AddDayName, "Fin de Semana",
				        each [Día Semana Nº] >= 6, type logical
				    ),
				
				    // CLAVE FECHA
				    AddDateKey = Table.AddColumn(
				        AddWeekend, "DateKey",
				        each [Año] * 10000 + [Mes] * 100 + [Día],
				        Int64.Type
				    ),
				
				    // OFFSETS DINÁMICOS
				    AddYearOffset = Table.AddColumn(
				        AddDateKey, "Offset Año",
				        each [Año] - Date.Year(Today), Int64.Type
				    ),
				
				    AddQuarterOffset = Table.AddColumn(
				        AddYearOffset, "Offset Trimestre",
				        each ([Año] - Date.Year(Today)) * 4 +
				             [Trimestre Nº] - Date.QuarterOfYear(Today),
				        Int64.Type
				    ),
				
				    AddMonthOffset = Table.AddColumn(
				        AddQuarterOffset, "Offset Mes",
				        each ([Año] - Date.Year(Today)) * 12 +
				             [Mes] - Date.Month(Today),
				        Int64.Type
				    ),
				
				    AddWeekOffset = Table.AddColumn(
				        AddMonthOffset, "Offset Semana",
				        each Number.IntegerDivide(
				            Duration.Days(
				                [Inicio Semana] -
				                Date.StartOfWeek(Today, Day.Monday)
				            ), 7
				        ),
				        Int64.Type
				    ),
				
				    AddDayOffset = Table.AddColumn(
				        AddWeekOffset, "Offset Día",
				        each Duration.Days([Date] - Today),
				        Int64.Type
				    ),
				
				    // SELECTORES DINÁMICOS
				    AddCurrentYear = Table.AddColumn(
				        AddDayOffset, "Año Actual",
				        each [Año] = Date.Year(Today), type logical
				    ),
				
				    AddCurrentMonth = Table.AddColumn(
				        AddCurrentYear, "Mes Actual",
				        each [Offset Mes] = 0, type logical
				    ),
				
				    AddPreviousYear = Table.AddColumn(
				        AddCurrentMonth, "Año Anterior",
				        each [Offset Año] = -1, type logical
				    ),
				
				    AddPreviousMonth = Table.AddColumn(
				        AddPreviousYear, "Mes Anterior",
				        each [Offset Mes] = -1, type logical
				    )
				
				in
				    AddPreviousMonth

	annotation PBI_ResultType = Table

