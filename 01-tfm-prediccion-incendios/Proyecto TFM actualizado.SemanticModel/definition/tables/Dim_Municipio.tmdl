	partition Dim_Municipio = m
		mode: import
		source =
				let
				  Origen = Fact_RiesgoIncendio,
				  #"Columnas quitadas" = Table.RemoveColumns(Origen, {"cluster_inicial_muestra", "num_incendios_2014_2024", "ha_quemadas_2014_2024", "temp_media_verano_aemet", "temp_maxima_media_verano_aemet", "humedad_media_verano_aemet", "precipitacion_verano_media_aemet", "velocidad_viento_media_aemet", "dias_sin_lluvia_estimados_aemet", "pct_masa_forestal", "pct_agricola", "pct_matorral", "continuidad_forestal", "distancia_cedefo_km", "num_cedefo_50km", "indice_incidencia_historica", "indice_riesgo_climatico", "indice_vulnerabilidad_territorial", "indice_cobertura_operativa", "riesgo_alto_binario", "score_riesgo_0_100", "nivel_riesgo_final", "nivel_riesgo_final_por_percentiles", "aemet_estacion_indicativo", "aemet_estacion_provincia", "aemet_distancia_estacion_km", "aemet_fecha_descarga", "cluster_territorial_id", "cluster_silhouette", "riesgo_real", "probabilidad_riesgo_alto", "prediccion_riesgo_alto", "acierto", "nivel_riesgo_modelo", "ClaveMunicipio"}),
				  #"Duplicados quitados" = Table.Distinct(#"Columnas quitadas", {"codigo_ine"}),
				  #"Personalizado agregado" = Table.AddColumn(#"Duplicados quitados", "Personalizado", each if [latitud] = null then null
				else
				let
				    n = Number.From([latitud])
				in
				    n / Number.Power(10, Text.Length(Text.From(Number.Abs(n))) - 2)),
				  #"Personalizado agregado 1" = Table.AddColumn(#"Personalizado agregado", "LongitudMapa", each if [longitud] = null then null
				else
				let
				    n = Number.From([longitud])
				in
				    n / Number.Power(10, Text.Length(Text.From(Number.Abs(n))) - 1)),
				  #"Tipo de columna cambiado" = Table.TransformColumnTypes(#"Personalizado agregado 1", {{"Personalizado", type number}, {"LongitudMapa", type number}}),
				  #"Columnas con nombre cambiado 1" = Table.RenameColumns(#"Tipo de columna cambiado", {{"Personalizado", "LatitudMapa"}})
				in
				  #"Columnas con nombre cambiado 1"

	annotation PBI_ResultType = Table

